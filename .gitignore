# ---------------------------------------------------------------
# 真实配置（含密码 / API Key / 服务器地址），绝不入库
# 仓库里只保留 config.example.json，首次运行会自动复制一份
# ---------------------------------------------------------------
config.json
config.local.json
*.local.json
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# 长期记忆（玩家聊天记录，属于隐私数据），绝不入库
# ---------------------------------------------------------------
memory.json
memory.json.tmp
*.memory.json
# Docker bind 挂载的数据目录（./data 里就是 memory.json）
/data/
data/*.json

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# 虚拟环境
.venv/
venv/
ENV/
env/

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------
# 运行时产物 / 日志
# ---------------------------------------------------------------
logs/
*.log
*.log.*
crash-*.txt

# ---------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
