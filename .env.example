# ================================================================
# mcserver-ai 容器环境变量模板
# 用法：cp .env.example .env  然后改成你自己的值
# （.env 已被 .gitignore 挡在仓库外，不会泄露）
#
# 注意：compose 会对 .env 做变量插值，密码里的 $ 需要写成 $$
# ================================================================

# ---------------- 运行模式 ----------------
# ssh   = 管家在容器里，SSH 到别的机器读日志（推荐，容器里 local 模式看不到宿主机命令）
# local = 管家直接读日志文件，需要把日志目录挂进容器（见 docker-compose.yml 的 volumes）
MC_READ_MODE=ssh

# ---------------- 机器人身份 ----------------
MC_BOT_NAME=大肥鱼
MC_TRIGGER_KEYWORD=@大肥鱼

# ---------------- 大模型 ----------------
DEEPSEEK_API_KEY=sk-在这里填入你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------- RCON（两种模式都必填）----------------
# 容器里的 127.0.0.1 指的是容器自己；指向宿主机请用 host.docker.internal 或局域网 IP
MC_RCON_HOST=host.docker.internal
MC_RCON_PORT=25575
MC_RCON_PASSWORD=在这里填入RCON密码

# ---------------- SSH（仅 ssh 模式需要）----------------
MC_SSH_HOST=host.docker.internal
MC_SSH_PORT=22
MC_SSH_USER=mcserver
MC_SSH_PASSWORD=在这里填入SSH密码
MC_SSH_LOG_PATH=~/minecraft/logs/latest.log

# ---------------- 权限矩阵 ----------------
# 逗号分隔；留空表示没有任何管理员
MC_OP_WHITELIST=
MC_NORMAL_ALLOW=list,tps,help,say,time,weather,tpa
# 留空则沿用模板里的绝对黑名单（建议别动）
# MC_ABSOLUTE_BLOCK=stop,reload,op,deop,ban,ban-ip,pardon

# ---------------- local 模式：容器内的日志路径 ----------------
# 只在 MC_READ_MODE=local 时生效，配合 compose 里挂载的 /logs 目录
# MC_LOCAL_LOG_PATH=/logs/latest.log

# ---------------- 可调参数（可选）----------------
# 任意 runtime 键都可以用 MC_RUNTIME_<键名大写> 覆盖
# MC_RUNTIME_TEMPERATURE=0.3
# MC_RUNTIME_MAX_TOOL_ROUNDS=3
# MC_RUNTIME_LOCAL_POLL_INTERVAL=0.3

# ---------------- 容器自身 ----------------
TZ=Asia/Shanghai
# 非 root 运行用的 UID/GID；要和挂载进来的日志文件属主对齐，不确定就留 1000
MC_UID=1000
MC_GID=1000
